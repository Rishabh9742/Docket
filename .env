# Copy this file to .env and fill in your own values.

PORT=3000
NODE_ENV=development

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docket
# Set to true for hosted databases that require SSL (Render, Neon, Supabase, Heroku...)
DATABASE_SSL=false

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
